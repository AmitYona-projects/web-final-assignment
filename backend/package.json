{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
        "dev": "nodemon ./src/index.ts",
        "start": "tsc && node ./dist/index.js",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write .",
        "test": "tsc && jest --detectOpenHandles --runInBand --forceExit",
        "test:auth": "tsc && jest --detectOpenHandles --forceExit src/tests/auth.test.ts",
        "test:user": "tsc && jest --detectOpenHandles --forceExit src/tests/users.test.ts",
        "test:comment": "tsc && jest --detectOpenHandles --forceExit src/tests/comments.test.ts",
        "test:post": "tsc && jest --detectOpenHandles --forceExit src/tests/posts.test.ts",
        "coverage": "tsc && jest --detectOpenHandles --coverage --runInBand --forceExit"
    },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
        "bcrypt": "^6.0.0",
        "body-parser": "^2.2.1",
        "dotenv": "^17.2.3",
        "env-var": "^7.5.0",
        "express": "^5.2.1",
        "express-winston": "^4.2.0",
        "helmet": "^8.1.0",
        "http-status-codes": "^2.3.0",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.0.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/bcrypt": "^6.0.0",
        "@types/body-parser": "^1.19.6",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/supertest": "^6.0.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.49.0",
        "@typescript-eslint/parser": "^8.49.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.2.0",
        "nodemon": "^3.1.11",
        "prettier": "^3.7.4",
        "supertest": "^7.1.4",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "ts-jest": "^29.4.6",
